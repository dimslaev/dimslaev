{
  "$description": "Catppuccin Macchiato design tokens (W3C Design Tokens format) for Claude Design /design-sync.",
  "color": {
    "macchiato": {
      "rosewater": { "$type": "color", "$value": "#f4dbd6" },
      "flamingo": { "$type": "color", "$value": "#f0c6c6" },
      "pink": { "$type": "color", "$value": "#f5bde6" },
      "mauve": { "$type": "color", "$value": "#c6a0f6" },
      "red": { "$type": "color", "$value": "#ed8796" },
      "maroon": { "$type": "color", "$value": "#ee99a0" },
      "peach": { "$type": "color", "$value": "#f5a97f" },
      "yellow": { "$type": "color", "$value": "#eed49f" },
      "green": { "$type": "color", "$value": "#a6da95" },
      "teal": { "$type": "color", "$value": "#8bd5ca" },
      "sky": { "$type": "color", "$value": "#91d7e3" },
      "sapphire": { "$type": "color", "$value": "#7dc4e4" },
      "blue": { "$type": "color", "$value": "#8aadf4" },
      "lavender": { "$type": "color", "$value": "#b7bdf8" },
      "text": { "$type": "color", "$value": "#cad3f5" },
      "subtext1": { "$type": "color", "$value": "#b8c0e0" },
      "subtext0": { "$type": "color", "$value": "#a5adcb" },
      "overlay2": { "$type": "color", "$value": "#939ab7" },
      "overlay1": { "$type": "color", "$value": "#8087a2" },
      "overlay0": { "$type": "color", "$value": "#6e738d" },
      "surface2": { "$type": "color", "$value": "#5b6078" },
      "surface1": { "$type": "color", "$value": "#494d64" },
      "surface0": { "$type": "color", "$value": "#363a4f" },
      "base": { "$type": "color", "$value": "#24273a" },
      "mantle": { "$type": "color", "$value": "#1e2030" },
      "crust": { "$type": "color", "$value": "#181926" }
    },
    "background": {
      "default": { "$type": "color", "$value": "{color.macchiato.base}" },
      "mantle": { "$type": "color", "$value": "{color.macchiato.mantle}" },
      "crust": { "$type": "color", "$value": "{color.macchiato.crust}" }
    },
    "surface": {
      "default": { "$type": "color", "$value": "{color.macchiato.surface0}" },
      "raised": { "$type": "color", "$value": "{color.macchiato.surface1}" },
      "overlay": { "$type": "color", "$value": "{color.macchiato.surface2}" }
    },
    "text": {
      "primary": { "$type": "color", "$value": "{color.macchiato.text}" },
      "secondary": { "$type": "color", "$value": "{color.macchiato.subtext1}" },
      "muted": { "$type": "color", "$value": "{color.macchiato.subtext0}" }
    },
    "border": {
      "default": { "$type": "color", "$value": "{color.macchiato.surface2}" },
      "subtle": { "$type": "color", "$value": "{color.macchiato.surface1}" }
    },
    "accent": {
      "primary": { "$type": "color", "$value": "{color.macchiato.blue}" },
      "secondary": { "$type": "color", "$value": "{color.macchiato.mauve}" },
      "tertiary": { "$type": "color", "$value": "{color.macchiato.pink}" }
    },
    "status": {
      "success": { "$type": "color", "$value": "{color.macchiato.green}" },
      "warning": { "$type": "color", "$value": "{color.macchiato.yellow}" },
      "danger": { "$type": "color", "$value": "{color.macchiato.red}" },
      "info": { "$type": "color", "$value": "{color.macchiato.sky}" }
    }
  },
  "typography": {
    "fontFamily": {
      "sans": { "$type": "fontFamily", "$value": ["MesloLGS Nerd Font", "MesloLGS NF", "system-ui", "sans-serif"] },
      "mono": { "$type": "fontFamily", "$value": ["MesloLGS Nerd Font Mono", "MesloLGS NF", "monospace"] }
    },
    "fontSize": {
      "xs": { "$type": "dimension", "$value": "0.75rem" },
      "sm": { "$type": "dimension", "$value": "0.875rem" },
      "base": { "$type": "dimension", "$value": "1rem" },
      "lg": { "$type": "dimension", "$value": "1.125rem" },
      "xl": { "$type": "dimension", "$value": "1.25rem" },
      "2xl": { "$type": "dimension", "$value": "1.5rem" },
      "3xl": { "$type": "dimension", "$value": "1.875rem" }
    },
    "fontWeight": {
      "regular": { "$type": "fontWeight", "$value": 400 },
      "medium": { "$type": "fontWeight", "$value": 500 },
      "semibold": { "$type": "fontWeight", "$value": 600 },
      "bold": { "$type": "fontWeight", "$value": 700 }
    },
    "lineHeight": {
      "tight": { "$type": "number", "$value": 1.2 },
      "normal": { "$type": "number", "$value": 1.5 },
      "relaxed": { "$type": "number", "$value": 1.75 }
    }
  },
  "spacing": {
    "0": { "$type": "dimension", "$value": "0rem" },
    "1": { "$type": "dimension", "$value": "0.25rem" },
    "2": { "$type": "dimension", "$value": "0.5rem" },
    "3": { "$type": "dimension", "$value": "0.75rem" },
    "4": { "$type": "dimension", "$value": "1rem" },
    "6": { "$type": "dimension", "$value": "1.5rem" },
    "8": { "$type": "dimension", "$value": "2rem" },
    "12": { "$type": "dimension", "$value": "3rem" },
    "16": { "$type": "dimension", "$value": "4rem" }
  },
  "radius": {
    "sm": { "$type": "dimension", "$value": "0.25rem" },
    "md": { "$type": "dimension", "$value": "0.5rem" },
    "lg": { "$type": "dimension", "$value": "0.75rem" },
    "full": { "$type": "dimension", "$value": "9999px" }
  }
}
