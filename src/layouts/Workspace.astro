---
import { getCollection } from "astro:content";
import Analytics from "@vercel/analytics/astro";
import "../styles/global.css";

const { note } = Astro.props;
const notes = (await getCollection("writing")).sort((a, b) =>
  a.data.date < b.data.date ? 1 : -1,
);

const words = (body = "") => body.trim().split(/\s+/).filter(Boolean).length;
const readSecs = (body = "") => Math.max(5, Math.round((words(body) / 230) * 60));
const readLen = (body = "") => {
  const s = readSecs(body);
  return s < 100 ? `${s}s` : `${Math.round(s / 60)}m`;
};
const readIso = (body = "") => {
  const s = readSecs(body);
  return s < 60 ? `PT${s}S` : `PT${Math.round(s / 60)}M`;
};

// Derive everything from Astro.site so canonicals cannot drift from the
// sitemap. Paths carry no trailing slash, matching trailingSlash: never.
const site = Astro.site ?? new URL("https://dimslaev.com");
const href = (p) => new URL(p, site).href;
const path = note ? `/writing/${note.id}` : "/";
const url = href(path);

const title = note
  ? `${note.data.title} · Dimslaev`
  : "Dimitar Slaev - Software engineer, LLM applications";
const desc = note
  ? note.data.desc
  : "Software engineer based in Geneva, Switzerland. LLM-powered applications, TypeScript, Node.js, Python.";

const published = note?.data.date;
const modified = note?.data.updated ?? published;

const person = {
  "@type": "Person",
  name: "Dimitar Slaev",
  url: href("/"),
  jobTitle: "Software engineer",
  sameAs: [
    "https://github.com/dimslaev",
    "https://www.linkedin.com/in/dimslaev/",
  ],
};

const ld = note
  ? {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      headline: note.data.title,
      description: note.data.desc,
      datePublished: published,
      dateModified: modified,
      url,
      mainEntityOfPage: url,
      inLanguage: "en",
      wordCount: words(note.body),
      timeRequired: readIso(note.body),
      author: person,
      publisher: person,
      isPartOf: { "@type": "Blog", name: "dimslaev", url: href("/") },
    }
  : {
      "@context": "https://schema.org",
      "@type": "Blog",
      name: "dimslaev",
      url: href("/"),
      description: desc,
      inLanguage: "en",
      author: person,
      publisher: person,
      blogPost: notes.map((n) => ({
        "@type": "BlogPosting",
        headline: n.data.title,
        description: n.data.desc,
        datePublished: n.data.date,
        dateModified: n.data.updated ?? n.data.date,
        url: href(`/writing/${n.id}`),
      })),
    };

const gitIcon =
  "M13,14C9.64,14 8.54,15.35 8.18,16.24C9.25,16.7 10,17.76 10,19A3,3 0 0,1 7,22A3,3 0 0,1 4,19C4,17.69 4.83,16.58 6,16.17V7.83C4.83,7.42 4,6.31 4,5A3,3 0 0,1 7,2A3,3 0 0,1 10,5C10,6.31 9.17,7.42 8,7.83V13.12C8.88,12.47 10.16,12 12,12C14.67,12 15.56,10.66 15.85,9.77C14.77,9.32 14,8.25 14,7A3,3 0 0,1 17,4A3,3 0 0,1 20,7C20,8.34 19.13,9.5 17.92,9.87C17.55,11.29 16.5,14 13,14M7,18A1,1 0 0,0 6,19A1,1 0 0,0 7,20A1,1 0 0,0 8,19A1,1 0 0,0 7,18M7,4A1,1 0 0,0 6,5A1,1 0 0,0 7,6A1,1 0 0,0 8,5A1,1 0 0,0 7,4M17,6A1,1 0 0,0 16,7A1,1 0 0,0 17,8A1,1 0 0,0 18,7A1,1 0 0,0 17,6Z";

const logo = `██████╗ ██╗███╗   ███╗███████╗██╗      █████╗ ███████╗██╗   ██╗
██╔══██╗██║████╗ ████║██╔════╝██║     ██╔══██╗██╔════╝██║   ██║
██║  ██║██║██╔████╔██║███████╗██║     ███████║█████╗  ██║   ██║
██║  ██║██║██║╚██╔╝██║╚════██║██║     ██╔══██║██╔══╝  ╚██╗ ██╔╝
██████╔╝██║██║ ╚═╝ ██║███████║███████╗██║  ██║███████╗ ╚████╔╝
╚═════╝ ╚═╝╚═╝     ╚═╝╚══════╝╚══════╝╚═╝  ╚═╝╚══════╝  ╚═══╝`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={desc} />
    <meta name="author" content="Dimitar Slaev" />
    <link rel="canonical" href={url} />
    <meta property="og:type" content={note ? "article" : "website"} />
    <meta property="og:site_name" content="dimslaev" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={url} />
    {
      note && (
        <>
          <meta property="article:published_time" content={published} />
          <meta property="article:modified_time" content={modified} />
          <meta property="article:author" content="Dimitar Slaev" />
        </>
      )
    }
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={desc} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="dimslaev - writing"
      href={href("/rss.xml")}
    />
    <link
      rel="icon"
      href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🖥️</text></svg>"
    />
    <link rel="preload" href="/fonts/Inter-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/JetBrainsMono-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/JetBrainsMono-600.woff2" as="font" type="font/woff2" crossorigin />
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    <Analytics />
  </head>
  <body>
    <div class="workspace" data-open={note ? "true" : "false"}>
      <section class="pane pane-list">
        <div class="prompt">
          <span class="ppath">~/dimslaev</span>
          <span class="pbranch"
            ><svg viewBox="0 0 24 24"><path d={gitIcon}></path></svg>main</span
          >
          <span class="parr">›</span>
          <span class="pcmd">ls writing/</span>
        </div>
        <div class="pane-body">
          {
            !note && (
              <h1 class="vh">
                Dimitar Slaev - software engineer building LLM-powered
                applications
              </h1>
            )
          }
          <pre class="logo" role="img" aria-label="dimslaev">{logo}</pre>

          <dl class="idcard">
            <div>
              <dt>about</dt>
              <dd>software engineer @ <span class="hl">infomaniak</span></dd>
            </div>
            <div>
              <dt>focus</dt>
              <dd>llms · agents · rag · data pipelines</dd>
            </div>
            <div>
              <dt>stack</dt>
              <dd>typescript · node.js · python</dd>
            </div>
            <div>
              <dt>tools</dt>
              <dd>claude code · opencode · tmux </dd>
            </div>
            <div>
              <dt>now</dt>
              <dd>
                building <a href="https://agentique.ch">agentique.ch</a>, a
                platform for ai news
              </dd>
            </div>
            <div>
              <dt>links</dt>
              <dd>
                <a href="https://github.com/dimslaev">github</a> · <a
                  href="https://www.linkedin.com/in/dimslaev/">linkedin</a
                > · <a href="/rss.xml">rss</a>
              </dd>
            </div>
          </dl>

          <h2 class="log-h">writing/</h2>
          <ul class="log">
            {
              notes.map((n) => (
                <li>
                  <a
                    class:list={["row", { active: note?.id === n.id }]}
                    href={`/writing/${n.id}`}
                  >
                    <time datetime={n.data.date}>{n.data.date}</time>
                    <span class="code">[200]</span>
                    <span class="path">/writing/{n.id}</span>
                    <span class="rt">{readLen(n.body)}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      {
        note && (
          <section class="pane pane-note">
            <div class="prompt">
              <span class="ppath">~/dimslaev</span>
              <span class="pbranch">
                <svg viewBox="0 0 24 24">
                  <path d={gitIcon} />
                </svg>
                main
              </span>
              <span class="parr">›</span>
              <span class="pcmd">cat writing/{note.id}.md</span>
              <a class="pclose" href="/" aria-label="close pane">
                <svg viewBox="0 0 24 24">
                  <path d="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z" />
                </svg>
              </a>
            </div>
            <div class="pane-body">
              <a class="back" href="/">
                <svg viewBox="0 0 24 24">
                  <path d="M20,11V13H8L13.5,18.5L12.08,19.92L4.16,12L12.08,4.08L13.5,5.5L8,11H20Z" />
                </svg>
                cd ..
              </a>
              <article>
                <h1>{note.data.title}</h1>
                <span class="sub">
                  <time datetime={published}>{published}</time> · note
                </span>
                <div class="body">
                  <slot />
                </div>
              </article>
            </div>
          </section>
        )
      }
    </div>
  </body>
</html>
